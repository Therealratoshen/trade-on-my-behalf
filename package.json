{
  "name": "agent-treasury",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Treasury - on-chain spending policy engine for AI agent wallets on Solana (Solana World Fair 2026)",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
