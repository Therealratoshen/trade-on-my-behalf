# Which cluster the dashboard reads. Default: devnet
NEXT_PUBLIC_CLUSTER=devnet

# Override the RPC endpoint. Default: clusterApiUrl(NEXT_PUBLIC_CLUSTER)
# For `pnpm demo` (local validator) use: http://127.0.0.1:8899
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# Paper-venue state file read by the /api/positions route handler.
# Default: <repo>/.demo/paper-local.json (first one found walking up from cwd).
# TOMB_PAPER_STATE=/absolute/path/to/paper-local.json
