{
  "name": "@trade-on-my-behalf/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Trade On My Behalf runtime: signal -> on-chain policy gate -> perps venue.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tomb": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --import tsx tests/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "tomb": "tsx src/cli.ts",
    "resolve-venue": "tsx src/cli.ts resolve-venue"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "@trade-on-my-behalf/sdk": "workspace:*",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
